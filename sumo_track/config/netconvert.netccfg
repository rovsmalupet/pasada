<?xml version="1.0" encoding="UTF-8"?>
<!-- Saved netconvert options for the Santa Rosa network (Phase 1, step 4).
     Do not run this file directly: `python -m sumo_track.network.build` runs it and
     passes the input (osm_extract from the data manifest), the output path and the
     clip polygon, so this file holds only the conversion choices. Paths here are
     relative to this file.

     "Hybrid" settings (2026-10-17): the OSM Web Wizard's lean options, which gave a
     visibly cleaner network than our first build, with our own typemap so people can
     still walk on every street. See docs/PROGRESS.md for the three-way comparison. -->
<configuration>
    <input>
        <!-- SUMO's default OSM typemap with bicycles allowed on trunk roads. type-files
             REPLACES the default typemap, so this is a full copy. Not the wizard's
             pedestrian typemap: that bans walking on every street without a mapped
             sidewalk, which in Santa Rosa is nearly all of them. -->
        <type-files value="osm_typemap.typ.xml"/>
    </input>
    <output>
        <output.street-names value="true"/>
        <!-- each lane keeps the id of the OSM way it came from -->
        <output.original-names value="true"/>
        <!-- keep the OSM tags on edges (oneway, lanes, ...) for the verification step -->
        <osm.all-attributes value="true"/>
    </output>
    <processing>
        <!-- simplify geometry: merge edges that only split for shape points -->
        <geometry.remove value="true"/>
        <ramps.guess value="true"/>
        <!-- merge clusters of nodes into one intersection -->
        <junctions.join value="true"/>
        <!-- Deliberately NOT:
             * sidewalks.guess - a guessed sidewalk on nearly every road cluttered the
               junctions; pedestrians walk on the road lane instead where no sidewalk
               is mapped (osm.sidewalks below imports the mapped ones).
             * opposites.guess - it lets cars overtake through the oncoming lane, but it
               caused ~39,000 of the ~44,800 warnings of the first build and changed
               4,348 edge lengths. Can be tried again once the base network is verified.
             * bikelanes.guess - it left disconnected bike-lane islands (prototype). -->
    </processing>
    <tls_building>
        <tls.guess-signals value="true"/>
        <tls.discard-simple value="true"/>
        <tls.join value="true"/>
    </tls_building>
    <edge_removal>
        <!-- drop fragments not connected to the main network (e.g. cut by the clip) -->
        <remove-edges.isolated value="true"/>
        <keep-edges.components value="1"/>
    </edge_removal>
    <pedestrian>
        <crossings.guess value="true"/>
    </pedestrian>
    <formats>
        <!-- use what OSM says about bicycle access and mapped sidewalks -->
        <osm.bike-access value="true"/>
        <osm.sidewalks value="true"/>
    </formats>
</configuration>
