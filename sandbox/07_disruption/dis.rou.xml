<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="jeepney" vClass="bus" length="7.0" personCapacity="20"
           maxSpeed="16.67" accel="1.3" decel="3.5"
           boardingDuration="3.0" color="1,0.6,0"/>
    <vType id="pedestrian" vClass="pedestrian" speed="1.34"/>

    <route id="r_eb" edges="AB BC CD"/>
    <flow id="JEEP_R01_EB" type="jeepney" route="r_eb" line="JEEP_R01_EB"
          begin="0" end="3000" period="300"/>

    <!-- TWO IDENTICAL TRIPS. Same origin, same flagging point, same
         destination. Only the departure time differs - and one of them
         runs straight into a disrupted edge. -->
    <person id="c_normal" type="pedestrian" depart="60" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="CD" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="CD" arrivalPos="400"/>
    </person>
    <person id="c_disrupted" type="pedestrian" depart="1000" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="CD" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="CD" arrivalPos="400"/>
    </person>
</routes>
