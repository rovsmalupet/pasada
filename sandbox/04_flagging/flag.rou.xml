<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="jeepney" vClass="bus" length="7.0" personCapacity="20"
           maxSpeed="16.67" accel="1.3" decel="3.5"
           boardingDuration="2.0" color="1,0.6,0"/>
    <vType id="pedestrian" vClass="pedestrian" speed="1.34"/>

    <route id="r_eb" edges="AB BC"/>

    <flow id="JEEP_R01_EB" type="jeepney" route="r_eb" line="JEEP_R01_EB"
          begin="0" end="900" period="300"/>

    <!-- ONE COMMUTER, THREE STAGES.
         There is NO bus stop anywhere in this network. The boarding point
         (AB @ 320 m) and alighting point (BC @ 300 m) are arbitrary
         roadside positions, chosen the way Phase 4 would choose them. -->
    <person id="commuter_1" type="pedestrian" depart="60" departPos="40">
        <walk edges="AB" arrivalPos="320"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB"/>
        <walk edges="BC" arrivalPos="450"/>
    </person>
</routes>
