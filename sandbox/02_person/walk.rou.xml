<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- A vType for people. In your thesis, `speed` comes from
         params.yaml: pedestrian_speed (m/s, status: placeholder). -->
    <vType id="pedestrian" vClass="pedestrian" speed="1.34"/>
    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" length="5.0" maxSpeed="16.67"/>

    <route id="r0" edges="AB BC"/>

    <!-- A PERSON is not a vehicle. It has no route attribute - instead it
         holds an ordered list of STAGES. Here there is one: a walk.
         A jeepney trip later = walk, then ride, then walk. -->
    <person id="ped0" type="pedestrian" depart="0" departPos="20">
        <walk edges="AB BC" arrivalPos="400"/>
    </person>

    <!-- Same road, same moment, a vehicle for comparison. -->
    <vehicle id="veh0" type="car" route="r0" depart="0"/>
</routes>
