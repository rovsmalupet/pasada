<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="hello.net.xml"/>
        <route-files value="hello.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="300"/>
        <!-- the plan pins this at 1 s -->
        <step-length value="1"/>
    </time>
    <output>
        <!-- one record per finished trip: this is the raw material for trip outcomes -->
        <tripinfo-output value="tripinfo.xml"/>
    </output>
</configuration>
