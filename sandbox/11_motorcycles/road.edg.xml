<?xml version="1.0" encoding="UTF-8"?>
<!-- Main road lanes are 3.6 m (a placeholder - Philippine national roads are
     roughly 3.35-3.65 m). With lateral-resolution 0.4 that is exactly nine
     0.4 m strips. A centred 1.8 m car then leaves two strips (0.8 m) clear on
     EACH side - room for a 0.75 m scooter on the kerb side or the centre-line
     side. On a 3.2 m lane with 0.8 m strips, a centred car touches all four
     strips and a motorcycle can never fit beside it. -->
<edges>
    <edge id="AC" from="A" to="C" numLanes="1" speed="13.89" width="3.6"/>
    <edge id="CA" from="C" to="A" numLanes="1" speed="13.89" width="3.6"/>
    <edge id="CB" from="C" to="B" numLanes="1" speed="13.89" width="3.6"/>
    <edge id="BC" from="B" to="C" numLanes="1" speed="13.89" width="3.6"/>
    <edge id="NC" from="N" to="C" numLanes="1" speed="11.11" width="3.2"/>
    <edge id="CN" from="C" to="N" numLanes="1" speed="11.11" width="3.2"/>
    <edge id="SC" from="S" to="C" numLanes="1" speed="11.11" width="3.2"/>
    <edge id="CS" from="C" to="S" numLanes="1" speed="11.11" width="3.2"/>
</edges>
