<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="jeep.net.xml"/>
        <route-files value="jeep.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3700"/>
        <step-length value="1"/>
    </time>
    <output>
        <tripinfo-output value="tripinfo.xml"/>
    </output>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
