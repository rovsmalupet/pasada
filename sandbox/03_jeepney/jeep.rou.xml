<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- ================= VEHICLE TYPES =================
         Every number below is a placeholder that belongs in params.yaml
         with a unit, a source and status: placeholder. None of these are
         real Santa Rosa figures. -->
    <vType id="jeepney"
           vClass="bus"                 
           length="7.0"                 
           personCapacity="20"          
           maxSpeed="16.67"             
           accel="1.3" decel="3.5"
           boardingDuration="2.0"       
           color="1,0.6,0"/>

    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" length="5.0" maxSpeed="16.67"/>

    <!-- ================= ROUTES =================
         A fixed edge sequence. The jeepney never deviates from this. -->
    <route id="r_eb" edges="AB BC"/>
    <route id="r_wb" edges="CB BA"/>

    <!-- ================= FLOWS =================
         A flow inserts a vehicle every `period` seconds = the HEADWAY.
         Two flows on the same route give the same corridor different
         headways at different times of day: headway[route][period]. -->

    <!-- "AM peak": one jeepney every 300 s, from t=0 to t=1800 -->
    <flow id="JEEP_R01_EB_peak" type="jeepney" route="r_eb" line="JEEP_R01_EB"
          begin="0" end="1800" period="300"/>

    <!-- "off-peak": one every 900 s, from t=1800 to t=3600 -->
    <flow id="JEEP_R01_EB_off"  type="jeepney" route="r_eb" line="JEEP_R01_EB"
          begin="1800" end="3600" period="900"/>

    <!-- opposite direction, its own headway -->
    <flow id="JEEP_R01_WB"      type="jeepney" route="r_wb" line="JEEP_R01_WB"
          begin="0" end="3600" period="600"/>
</routes>
