<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- personCapacity deliberately TINY so we can force a full jeepney.
         Real value comes from field observation (params.yaml). -->
    <vType id="jeepney" vClass="bus" length="7.0" personCapacity="4"
           maxSpeed="16.67" accel="1.3" decel="3.5"
           boardingDuration="3.0" color="1,0.6,0"/>
    <vType id="pedestrian" vClass="pedestrian" speed="1.34"/>

    <route id="r_eb" edges="AB BC"/>

    <flow id="JEEP_R01_EB" type="jeepney" route="r_eb" line="JEEP_R01_EB"
          begin="0" end="1500" period="300"/>

    <!-- FOUR commuters at the SAME flagging point (AB @ 200 m), for a
         jeepney with only 3 seats. One must be left behind.
         A FIFTH waits further along at AB @ 420 m - by then the jeepney
         is full, so it should pass them by. -->
    <person id="c1" type="pedestrian" depart="60" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="BC" arrivalPos="400"/>
    </person>
    <person id="c2" type="pedestrian" depart="60" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="BC" arrivalPos="400"/>
    </person>
    <person id="c3" type="pedestrian" depart="60" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="BC" arrivalPos="400"/>
    </person>
    <person id="c4" type="pedestrian" depart="60" departPos="150">
        <walk edges="AB" arrivalPos="200"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB" arrivalPos="300"/>
        <walk edges="BC" arrivalPos="400"/>
    </person>
    <person id="c5" type="pedestrian" depart="60" departPos="370">
        <walk edges="AB" arrivalPos="420"/>
        <ride from="AB" to="BC" lines="JEEP_R01_EB" arrivalPos="450"/>
        <walk edges="BC" arrivalPos="480"/>
    </person>
</routes>
