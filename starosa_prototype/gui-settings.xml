<!-- gui-settings.xml — how sumo-gui opens when jeepney_controller.py launches it.
     * delay 100 ms per simulated second: the whole hour plays in ~6 minutes and
       the boardings (t = 170-1300 s) are slow enough to follow. Use the
       "Delay (ms)" box in the toolbar to speed up / slow down live.
     * persons drawn 4x larger (they are tiny at corridor zoom). Vehicles stay
       true size, so you can see a jeepney tucked against the kerb side of its
       lane (enlarged, it would look wider than the lane itself).
     * viewport centred on the kerbside stretch of route JPN1 where every
       boarding and alighting happens. -->
<viewsettings>
    <scheme name="jeepney prototype">
        <persons person_exaggeration="4" person_minSize="2"/>
    </scheme>
    <delay value="100"/>
    <viewport zoom="250" x="2378.7" y="1890.7"/>
</viewsettings>
