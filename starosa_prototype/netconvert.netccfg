<?xml version="1.0" encoding="UTF-8"?>
<!-- Custom network conversion config (Section 4.4.1.1, stage two).
     Run with:  netconvert -c netconvert.netccfg
     Keep this file in git: it makes the network regenerable. -->
<configuration>
    <input>
        <osm-files value="santarosa.osm"/>
        <!-- full copy of SUMO's default typemap with one change: highway.trunk
             (Philippine national/provincial highways) no longer disallows
             bicycle - see typemap.typ.xml for why. netconvert's type-files
             option REPLACES the built-in default rather than layering on it,
             so this must be the complete typemap, not just a diff. -->
        <type-files value="typemap.typ.xml"/>
    </input>
    <output>
        <output-file value="santarosa.net.xml"/>
        <output.street-names value="true"/>
    </output>
    <processing>
        <!-- generate pedestrian infrastructure where OSM doesn't tag it -->
        <sidewalks.guess value="true"/>
        <crossings.guess value="true"/>
        <!-- Deliberately NOT using bikelanes.guess: it carves out a physically
             separate bike lane on a subset of edges and strips bicycle
             permission from the general lane on those same edges, producing
             disconnected bike-lane islands (confirmed empirically - most
             random bike trips had no path at all). That also doesn't match
             how cycling actually works on Philippine roads: no segregated
             infrastructure on most streets, cyclists ride the rightmost part
             of the general lane. Leaving this off keeps bicycles on the
             default general-lane permissions (allowed everywhere except
             motorway/motorway_link - see typemap.typ.xml for the trunk-road
             exception). -->
        <!-- record which lanes face each other across the centre line, so
             vehicles can overtake through the oncoming lane when it's clear -
             how cars get past a jeepney loading at the kerb on a two-lane
             road (see run.sumocfg: lateral-resolution). Averages the lengths
             of each opposite pair, so some edges change length by a few m -
             re-run make_passengers.py after rebuilding the network. -->
        <opposites.guess value="true"/>
        <!-- merge clustered junction nodes into single intersections -->
        <junctions.join value="true"/>
        <!-- drop fragments disconnected from the main network -->
        <remove-edges.isolated value="true"/>
        <keep-edges.components value="1"/>
        <!-- sensible traffic light programs -->
        <tls.guess-signals value="true"/>
        <tls.discard-simple value="true"/>
    </processing>
</configuration>
