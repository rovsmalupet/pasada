# Applies to the whole PASADA-abm repository. A pattern without a folder
# prefix matches in every folder; prefix track-specific rules with the folder.

# Python (all folders)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (all folders); each person recreates their own
.venv/

# Operating system files
.DS_Store
Thumbs.db

# Personal notes and LLM session context: local only, never committed
sumo_track/docs/
sandbox/docs/
starosa_prototype/docs/
sumo_track_prototype/docs/
starosa_bayan/docs/

# SUMO track -----------------------------------------------------------------
# Generated outputs: rebuilt by scripts, never hand-edited
sumo_track/data/processed/
sumo_track/runs/

# Large untouched downloads; keep a note of each file's source URL and download date
sumo_track/data/raw/

# SUMO track prototype ------------------------------------------------------
# Rebuilt by build.py (generated/) and written by each run (runs/)
sumo_track_prototype/generated/
sumo_track_prototype/runs/

# Santa Rosa prototype, multi-line setup (run.py) ---------------------------
# Rebuilt by build.py (generated/) and written by each run (runs/)
starosa_prototype/generated/
starosa_prototype/runs/

# Santa Rosa bayan prototype (a copy of the multi-line setup on another map) -
# Rebuilt by build.py (generated/) and written by each run (runs/)
starosa_bayan/generated/
starosa_bayan/runs/
starosa_bayan/demand/old/
# 67 MB: rebuild from the committed bayan.osm with netconvert -c netconvert.netccfg (or make_map.py)
starosa_bayan/bayan.net.xml

# local test of starosa_bayan with a real LLM (llm_test/README.md)
llm_test/
